# Z80 Input and output group: IN, OUT, INI IND INIR INDR, OUTI OUTD OTIR OTDR.
# Directed vectors, randomized registers and operands (boundary-biased); full register check after each
# test instruction. Expected values: independent reference model (see Z80.coverage.md).
# Generated; do not edit.


# ---- Z80 bus profile --------------------------------------------------------
# One call = one T-state edge or one bus cycle. Pins: NotM1 NotMREQ NotIORQ NotRD
# NotWR NotRFSH NotHALT NotWAIT NotINT NotNMI NotRESET NotBUSREQ NotBUSACK CLK, buses A D.
# Outputs follow a clock edge one cycle later (stable write lag), hence `step 2`.
def RISE
  drive CLK = H
  step 2
end
def FALL
  drive CLK = L
  step 2
end
# Every control output after an edge: M1 MREQ IORQ RD WR RFSH HALT BUSACK (H, L or F).
def PINS
  expect NotM1 = $0
  expect NotMREQ = $1
  expect NotIORQ = $2
  expect NotRD = $3
  expect NotWR = $4
  expect NotRFSH = $5
  expect NotHALT = $6
  expect NotBUSACK = $7
end
def IDLE_STROBES
  expect NotMREQ = H
  expect NotIORQ = H
  expect NotRD = H
  expect NotWR = H
end
# One internal T-state: no strobe is active.
def XT1
  RISE
  IDLE_STROBES
  expect NotM1 = H
  expect NotRFSH = H
  FALL
  IDLE_STROBES
end
def XT2
  XT1
  XT1
end
def XT3
  XT1
  XT1
  XT1
end
def XT4
  XT2
  XT2
end
def XT5
  XT4
  XT1
end
# Opcode fetch, 4 T-states. $0 = PC, $1 = opcode, $2 = refresh address I:R (R before its increment).
def M1
  RISE
  expect A = $0
  expect NotM1 = L
  expect NotMREQ = H
  expect NotRD = H
  expect NotWR = H
  expect NotIORQ = H
  expect NotRFSH = H
  FALL
  expect NotMREQ = L
  expect NotRD = L
  expect NotM1 = L
  drive D = $1
  RISE
  expect NotMREQ = L
  expect NotRD = L
  FALL
  expect NotMREQ = L
  expect NotRD = L
  RISE
  clear D
  expect NotMREQ = H
  expect NotRD = H
  expect NotM1 = H
  expect NotRFSH = L
  expect A = $2
  FALL
  expect NotMREQ = L
  expect NotRD = H
  expect NotRFSH = L
  RISE
  expect NotMREQ = L
  expect NotRFSH = L
  FALL
  expect NotMREQ = H
  expect NotRD = H
  expect NotRFSH = L
end
# Memory read, 3 T-states. $0 = address, $1 = data.
def MR3
  RISE
  expect A = $0
  expect NotM1 = H
  expect NotMREQ = H
  expect NotRD = H
  expect NotWR = H
  expect NotIORQ = H
  FALL
  expect NotMREQ = L
  expect NotRD = L
  expect NotWR = H
  drive D = $1
  RISE
  expect NotMREQ = L
  expect NotRD = L
  FALL
  expect NotMREQ = L
  expect NotRD = L
  RISE
  expect NotMREQ = L
  expect NotRD = L
  FALL
  clear D
  IDLE_STROBES
end
# Memory write, 3 T-states. $0 = address, $1 = data. D is driven by the CPU from T1 falling
# to the next rising edge.
def MW3
  RISE
  expect A = $0
  expect NotM1 = H
  expect NotMREQ = H
  expect NotWR = H
  expect NotRD = H
  expect NotIORQ = H
  FALL
  expect NotMREQ = L
  expect NotWR = H
  expect NotRD = H
  expect D = $1
  RISE
  expect NotMREQ = L
  expect NotWR = H
  expect D = $1
  FALL
  expect NotMREQ = L
  expect NotWR = L
  expect D = $1
  RISE
  expect NotMREQ = L
  expect NotWR = L
  expect D = $1
  FALL
  IDLE_STROBES
  expect D = $1
end
# I/O read, 4 T-states (T1 T2 TW T3). $0 = port address A15-A0, $1 = data.
def IOR
  RISE
  expect A = $0
  expect NotMREQ = H
  expect NotIORQ = H
  expect NotRD = H
  FALL
  expect NotIORQ = H
  expect NotRD = H
  RISE
  expect NotIORQ = L
  expect NotRD = L
  expect NotMREQ = H
  FALL
  expect NotIORQ = L
  expect NotRD = L
  drive D = $1
  RISE
  expect NotIORQ = L
  expect NotRD = L
  FALL
  expect NotIORQ = L
  expect NotRD = L
  RISE
  expect NotIORQ = L
  expect NotRD = L
  FALL
  clear D
  IDLE_STROBES
  expect NotRFSH = H
end
# I/O write, 4 T-states. $0 = port address, $1 = data. D is driven from T1 falling to the next
# rising edge.
def IOW
  RISE
  expect A = $0
  expect NotMREQ = H
  expect NotIORQ = H
  expect NotWR = H
  FALL
  expect NotIORQ = H
  expect NotWR = H
  expect D = $1
  RISE
  expect NotIORQ = L
  expect NotWR = L
  expect NotMREQ = H
  expect D = $1
  FALL
  expect NotIORQ = L
  expect NotWR = L
  expect D = $1
  RISE
  expect NotIORQ = L
  expect NotWR = L
  expect D = $1
  FALL
  expect NotIORQ = L
  expect NotWR = L
  RISE
  expect NotIORQ = L
  expect NotWR = L
  expect D = $1
  FALL
  IDLE_STROBES
  expect D = $1
end
# Interrupt acknowledge M1, 6 T-states (T1 T2 TW TW T3 T4) before any extension.
# $0 = PC, $1 = vector byte, $2 = refresh address.
def INTA
  RISE
  expect A = $0
  expect NotM1 = L
  expect NotMREQ = H
  expect NotIORQ = H
  expect NotRD = H
  FALL
  expect NotMREQ = H
  expect NotIORQ = H
  expect NotRD = H
  RISE
  FALL
  expect NotIORQ = H
  RISE
  expect NotIORQ = H
  FALL
  expect NotIORQ = L
  expect NotM1 = L
  expect NotRD = H
  expect NotMREQ = H
  drive D = $1
  RISE
  expect NotIORQ = L
  FALL
  expect NotIORQ = L
  RISE
  clear D
  expect NotIORQ = H
  expect NotM1 = H
  expect NotRFSH = L
  expect NotMREQ = H
  expect A = $2
  FALL
  expect NotMREQ = L
  RISE
  expect NotMREQ = L
  FALL
  expect NotMREQ = H
  expect NotRFSH = L
end

# ---- lean variants for bulk vectors: same cycles, no address checks ---------
def M1L
  RISE
  expect NotM1 = L
  FALL
  expect NotMREQ = L
  expect NotRD = L
  drive D = $0
  RISE
  FALL
  RISE
  clear D
  expect NotRFSH = L
  expect NotM1 = H
  FALL
  RISE
  FALL
  expect NotMREQ = H
end
def MRL
  RISE
  expect NotM1 = H
  FALL
  expect NotMREQ = L
  expect NotRD = L
  drive D = $0
  RISE
  FALL
  RISE
  FALL
  clear D
  IDLE_STROBES
end

# ---- power-on / reset -------------------------------------------------------
# Inputs idle, RESET low for three clocks, then released on a falling edge; the first
# RISE after this call is T1 of the first M1 cycle.
def START
  drive NotWAIT = H
  drive NotINT = H
  drive NotNMI = H
  drive NotBUSREQ = H
  drive NotRESET = L
  FALL
  RISE
  FALL
  RISE
  FALL
  RISE
  FALL
  drive NotRESET = H
end
# Full register check. Arguments: PC SP IX IY  A F B C D E H L  A2 F2 B2 C2 D2 E2 H2 L2  I R IFF1 IFF2 IM
def REGS
  expect reg.PC = $0
  expect reg.SP = $1
  expect reg.IX = $2
  expect reg.IY = $3
  expect reg.A = $4
  expect reg.F = $5
  expect reg.B = $6
  expect reg.C = $7
  expect reg.D = $8
  expect reg.E = $9
  expect reg.H = $10
  expect reg.L = $11
  expect reg.A2 = $12
  expect reg.F2 = $13
  expect reg.B2 = $14
  expect reg.C2 = $15
  expect reg.D2 = $16
  expect reg.E2 = $17
  expect reg.H2 = $18
  expect reg.L2 = $19
  expect reg.I = $20
  expect reg.R = $21
  expect reg.IFF1 = $22
  expect reg.IFF2 = $23
  expect reg.IM = $24
end


