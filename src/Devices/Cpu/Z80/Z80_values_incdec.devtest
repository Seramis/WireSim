# Z80 INC/DEC r and INC/DEC (HL): all 256 values, both carry-in values (the carry is preserved).
# One vector per line, expected values from the reference model; see Z80.coverage.md.
# Generated; do not edit.


# ---- Z80 bus profile --------------------------------------------------------
# One call = one T-state edge or one bus cycle. Pins: NotM1 NotMREQ NotIORQ NotRD
# NotWR NotRFSH NotHALT NotWAIT NotINT NotNMI NotRESET NotBUSREQ NotBUSACK CLK, buses A D.
# Outputs follow a clock edge one cycle later (stable write lag), hence `step 2`.
def RISE
  drive CLK = H
  step 2
end
def FALL
  drive CLK = L
  step 2
end
# Every control output after an edge: M1 MREQ IORQ RD WR RFSH HALT BUSACK (H, L or F).
def PINS
  expect NotM1 = $0
  expect NotMREQ = $1
  expect NotIORQ = $2
  expect NotRD = $3
  expect NotWR = $4
  expect NotRFSH = $5
  expect NotHALT = $6
  expect NotBUSACK = $7
end
def IDLE_STROBES
  expect NotMREQ = H
  expect NotIORQ = H
  expect NotRD = H
  expect NotWR = H
end
# One internal T-state: no strobe is active.
def XT1
  RISE
  IDLE_STROBES
  expect NotM1 = H
  expect NotRFSH = H
  FALL
  IDLE_STROBES
end
def XT2
  XT1
  XT1
end
def XT3
  XT1
  XT1
  XT1
end
def XT4
  XT2
  XT2
end
def XT5
  XT4
  XT1
end
# Opcode fetch, 4 T-states. $0 = PC, $1 = opcode, $2 = refresh address I:R (R before its increment).
def M1
  RISE
  expect A = $0
  expect NotM1 = L
  expect NotMREQ = H
  expect NotRD = H
  expect NotWR = H
  expect NotIORQ = H
  expect NotRFSH = H
  FALL
  expect NotMREQ = L
  expect NotRD = L
  expect NotM1 = L
  drive D = $1
  RISE
  expect NotMREQ = L
  expect NotRD = L
  FALL
  expect NotMREQ = L
  expect NotRD = L
  RISE
  clear D
  expect NotMREQ = H
  expect NotRD = H
  expect NotM1 = H
  expect NotRFSH = L
  expect A = $2
  FALL
  expect NotMREQ = L
  expect NotRD = H
  expect NotRFSH = L
  RISE
  expect NotMREQ = L
  expect NotRFSH = L
  FALL
  expect NotMREQ = H
  expect NotRD = H
  expect NotRFSH = L
end
# Memory read, 3 T-states. $0 = address, $1 = data.
def MR3
  RISE
  expect A = $0
  expect NotM1 = H
  expect NotMREQ = H
  expect NotRD = H
  expect NotWR = H
  expect NotIORQ = H
  FALL
  expect NotMREQ = L
  expect NotRD = L
  expect NotWR = H
  drive D = $1
  RISE
  expect NotMREQ = L
  expect NotRD = L
  FALL
  expect NotMREQ = L
  expect NotRD = L
  RISE
  expect NotMREQ = L
  expect NotRD = L
  FALL
  clear D
  IDLE_STROBES
end
# Memory write, 3 T-states. $0 = address, $1 = data. D is driven by the CPU from T1 falling
# to the next rising edge.
def MW3
  RISE
  expect A = $0
  expect NotM1 = H
  expect NotMREQ = H
  expect NotWR = H
  expect NotRD = H
  expect NotIORQ = H
  FALL
  expect NotMREQ = L
  expect NotWR = H
  expect NotRD = H
  expect D = $1
  RISE
  expect NotMREQ = L
  expect NotWR = H
  expect D = $1
  FALL
  expect NotMREQ = L
  expect NotWR = L
  expect D = $1
  RISE
  expect NotMREQ = L
  expect NotWR = L
  expect D = $1
  FALL
  IDLE_STROBES
  expect D = $1
end
# I/O read, 4 T-states (T1 T2 TW T3). $0 = port address A15-A0, $1 = data.
def IOR
  RISE
  expect A = $0
  expect NotMREQ = H
  expect NotIORQ = H
  expect NotRD = H
  FALL
  expect NotIORQ = H
  expect NotRD = H
  RISE
  expect NotIORQ = L
  expect NotRD = L
  expect NotMREQ = H
  FALL
  expect NotIORQ = L
  expect NotRD = L
  drive D = $1
  RISE
  expect NotIORQ = L
  expect NotRD = L
  FALL
  expect NotIORQ = L
  expect NotRD = L
  RISE
  expect NotIORQ = L
  expect NotRD = L
  FALL
  clear D
  IDLE_STROBES
  expect NotRFSH = H
end
# I/O write, 4 T-states. $0 = port address, $1 = data. D is driven from T1 falling to the next
# rising edge.
def IOW
  RISE
  expect A = $0
  expect NotMREQ = H
  expect NotIORQ = H
  expect NotWR = H
  FALL
  expect NotIORQ = H
  expect NotWR = H
  expect D = $1
  RISE
  expect NotIORQ = L
  expect NotWR = L
  expect NotMREQ = H
  expect D = $1
  FALL
  expect NotIORQ = L
  expect NotWR = L
  expect D = $1
  RISE
  expect NotIORQ = L
  expect NotWR = L
  expect D = $1
  FALL
  expect NotIORQ = L
  expect NotWR = L
  RISE
  expect NotIORQ = L
  expect NotWR = L
  expect D = $1
  FALL
  IDLE_STROBES
  expect D = $1
end
# Interrupt acknowledge M1, 6 T-states (T1 T2 TW TW T3 T4) before any extension.
# $0 = PC, $1 = vector byte, $2 = refresh address.
def INTA
  RISE
  expect A = $0
  expect NotM1 = L
  expect NotMREQ = H
  expect NotIORQ = H
  expect NotRD = H
  FALL
  expect NotMREQ = H
  expect NotIORQ = H
  expect NotRD = H
  RISE
  FALL
  expect NotIORQ = H
  RISE
  expect NotIORQ = H
  FALL
  expect NotIORQ = L
  expect NotM1 = L
  expect NotRD = H
  expect NotMREQ = H
  drive D = $1
  RISE
  expect NotIORQ = L
  FALL
  expect NotIORQ = L
  RISE
  clear D
  expect NotIORQ = H
  expect NotM1 = H
  expect NotRFSH = L
  expect NotMREQ = H
  expect A = $2
  FALL
  expect NotMREQ = L
  RISE
  expect NotMREQ = L
  FALL
  expect NotMREQ = H
  expect NotRFSH = L
end

# ---- lean variants for bulk vectors: same cycles, no address checks ---------
def M1L
  RISE
  expect NotM1 = L
  FALL
  expect NotMREQ = L
  expect NotRD = L
  drive D = $0
  RISE
  FALL
  RISE
  clear D
  expect NotRFSH = L
  expect NotM1 = H
  FALL
  RISE
  FALL
  expect NotMREQ = H
end
def MRL
  RISE
  expect NotM1 = H
  FALL
  expect NotMREQ = L
  expect NotRD = L
  drive D = $0
  RISE
  FALL
  RISE
  FALL
  clear D
  IDLE_STROBES
end

# ---- power-on / reset -------------------------------------------------------
# Inputs idle, RESET low for three clocks, then released on a falling edge; the first
# RISE after this call is T1 of the first M1 cycle.
def START
  drive NotWAIT = H
  drive NotINT = H
  drive NotNMI = H
  drive NotBUSREQ = H
  drive NotRESET = L
  FALL
  RISE
  FALL
  RISE
  FALL
  RISE
  FALL
  drive NotRESET = H
end
# Full register check. Arguments: PC SP IX IY  A F B C D E H L  A2 F2 B2 C2 D2 E2 H2 L2  I R IFF1 IFF2 IM
def REGS
  expect reg.PC = $0
  expect reg.SP = $1
  expect reg.IX = $2
  expect reg.IY = $3
  expect reg.A = $4
  expect reg.F = $5
  expect reg.B = $6
  expect reg.C = $7
  expect reg.D = $8
  expect reg.E = $9
  expect reg.H = $10
  expect reg.L = $11
  expect reg.A2 = $12
  expect reg.F2 = $13
  expect reg.B2 = $14
  expect reg.C2 = $15
  expect reg.D2 = $16
  expect reg.E2 = $17
  expect reg.H2 = $18
  expect reg.L2 = $19
  expect reg.I = $20
  expect reg.R = $21
  expect reg.IFF1 = $22
  expect reg.IFF2 = $23
  expect reg.IM = $24
end


# ---- bulk vector macros (SP = 8000h, set by each file's preamble) ----------------
def LDA
  M1L 0x3e
  MRL $0
end
def LDB
  M1L 0x06
  MRL $0
end
def LDHL
  M1L 0x21
  MRL $0
  MRL $1
end
def LDBC
  M1L 0x01
  MRL $0
  MRL $1
end
# LD BC,af ; PUSH BC ; POP AF  ($0 = A, $1 = F)
def SETAF
  M1L 0x01
  MRL $1
  MRL $0
  M1L 0xc5
  XT1
  MW3 0x7fff $0
  MW3 0x7ffe $1
  M1L 0xf1
  MR3 0x7ffe $1
  MR3 0x7fff $0
end
def SCF
  M1L 0x37
end
def CLEARCARRY
  M1L 0xb7
end
def CHECK_AF
  expect reg.A = $0
  expect reg.F = $1
end
# 8-bit ALU with an immediate operand: $0 opcode, $1 A, $2 n, then expected A and F
def V_ALU
  LDA $1
  M1L $0
  MRL $2
  CHECK_AF $3 $4
end
# the same with a chosen flag register ($2 = F in; $3 = n)
def V_ALUC
  SETAF $1 $2
  M1L $0
  MRL $3
  CHECK_AF $4 $5
end
def V_DAA
  SETAF $0 $1
  M1L 0x27
  CHECK_AF $2 $3
end
def V_NEG
  LDA $0
  M1L 0xed
  M1L 0x44
  CHECK_AF $1 $2
end
# INC/DEC B: $0 opcode, $1 B, $2 = carry in (0/1 via macro name), expected B, F
def V_INCB0
  LDB $1
  CLEARCARRY
  M1L $0
  expect reg.B = $2
  expect reg.F = $3
end
def V_INCB1
  LDB $1
  SCF
  M1L $0
  expect reg.B = $2
  expect reg.F = $3
end
# INC/DEC (HL) with HL = 4000h: $0 opcode, $1 old value, $2 new value, $3 F, carry via preceding macro
def V_INCHL0
  CLEARCARRY
  M1L $0
  MR3 0x4000 $1
  XT1
  MW3 0x4000 $2
  expect reg.F = $3
end
def V_INCHL1
  SCF
  M1L $0
  MR3 0x4000 $1
  XT1
  MW3 0x4000 $2
  expect reg.F = $3
end
# CB rotate/shift on B ($0 = second byte), carry in 0 / 1
def V_ROTB0
  LDB $1
  CLEARCARRY
  M1L 0xcb
  M1L $0
  expect reg.B = $2
  expect reg.F = $3
end
def V_ROTB1
  LDB $1
  SCF
  M1L 0xcb
  M1L $0
  expect reg.B = $2
  expect reg.F = $3
end
# RLCA RLA RRCA RRA: $0 opcode, $1 A, $2 F in, expected A, F
def V_ROTA
  SETAF $1 $2
  M1L $0
  CHECK_AF $3 $4
end
# BIT/SET/RES on B: $0 = second byte
def V_BITB0
  LDB $1
  CLEARCARRY
  M1L 0xcb
  M1L $0
  expect reg.B = $2
  expect reg.FZ = $3
  expect reg.FH = $4
  expect reg.FN = $5
  expect reg.FC = $6
end
def V_BITB1
  LDB $1
  SCF
  M1L 0xcb
  M1L $0
  expect reg.B = $2
  expect reg.FZ = $3
  expect reg.FH = $4
  expect reg.FN = $5
  expect reg.FC = $6
end
def V_SRB
  LDB $1
  M1L 0xcb
  M1L $0
  expect reg.B = $2
end
# 16-bit: HL op BC. ADD: $0 $1 = HL lo hi, $2 $3 = BC lo hi, expected H, L, F.
# ADC/SBC: $0 = second opcode byte, then HL lo hi, BC lo hi, expected H, L, F (carry in via CLEARCARRY / SCF).
def V_ADDHL
  LDHL $0 $1
  LDBC $2 $3
  M1L 0x09
  XT4
  XT3
  expect reg.H = $4
  expect reg.L = $5
  expect reg.F = $6
end
def V_ADCHL0
  LDHL $1 $2
  LDBC $3 $4
  CLEARCARRY
  M1L 0xed
  M1L $0
  XT4
  XT3
  expect reg.H = $5
  expect reg.L = $6
  expect reg.F = $7
end
def V_ADCHL1
  LDHL $1 $2
  LDBC $3 $4
  SCF
  M1L 0xed
  M1L $0
  XT4
  XT3
  expect reg.H = $5
  expect reg.L = $6
  expect reg.F = $7
end
# LD A,I / LD A,R flags: A <- I with IFF2 = $1 via EI/DI. $0 = I value
def V_LDAI
  LDA $0
  M1L 0xed
  M1L 0x47
  XT1
  M1L $1
  M1L 0xed
  M1L 0x57
  XT1
  expect reg.A = $0
  expect reg.F = $2
end
# IN F,(C) (ED 70: flags only), BC = 0410h, carry in via CLEARCARRY / SCF: $0 = data, $1 = expected F
def V_INF0
  CLEARCARRY
  M1L 0xed
  M1L 0x70
  IOR 0x0410 $0
  expect reg.F = $1
end
def V_INF1
  SCF
  M1L 0xed
  M1L 0x70
  IOR 0x0410 $0
  expect reg.F = $1
end
# CPL / SCF / CCF with a chosen A and F: $0 = A, $1 = F, expected A, F
def V_CPL
  SETAF $0 $1
  M1L 0x2f
  CHECK_AF $2 $3
end
def V_SCF
  SETAF $0 $1
  M1L 0x37
  CHECK_AF $2 $3
end
def V_CCF
  SETAF $0 $1
  M1L 0x3f
  CHECK_AF $2 $3
end
# CPI with HL = 4000h, BC = 0002h: $0 = A, $1 = byte at (HL), expected F
def V_CPI
  LDA $0
  LDHL 0x00 0x40
  LDBC 0x02 0x00
  M1L 0xed
  M1L 0xa1
  MR3 0x4000 $1
  XT5
  expect reg.F = $2
end

