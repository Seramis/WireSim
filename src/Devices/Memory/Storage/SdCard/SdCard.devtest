# SdCard in SPI mode (mode 0, MSB first) backed by a file. Walks the SD SPI
# protocol the way a host does: 80 clocks with /CS high, CMD0, CMD8, CMD55 +
# ACMD41 polling, CMD58, then CSD/CID, single and multi-block read, single and
# multi-block write (checked in the backing file), CRC mode, rejected
# commands and /CS aborting a transfer. See SdCard.md and
# src/Testing/DeviceHarness.md for the script grammar.
#
# One SPI clock = three cycles: SCLK rises (MISO is sampled here), SCLK falls,
# one more cycle for the card's stable-phase MISO update to become visible.
# MISO is only checked by BIT and RXB; CLK and TXB ignore it.

def BIT                  # $0 = MOSI bit, $1 = expected MISO bit
  drive MOSI = $0
  drive SCLK = H
  step
  expect MISO = $1
  drive SCLK = L
  step
  step
end

def CLK                  # $0 = MOSI bit, MISO not checked
  drive MOSI = $0
  drive SCLK = H
  step
  drive SCLK = L
  step
  step
end

def TXB                  # send one byte, MSB first, MISO ignored
  CLK $0
  CLK $1
  CLK $2
  CLK $3
  CLK $4
  CLK $5
  CLK $6
  CLK $7
end

def RXB                  # clock out one byte (MOSI high), expect it MSB first
  BIT 1 $0
  BIT 1 $1
  BIT 1 $2
  BIT 1 $3
  BIT 1 $4
  BIT 1 $5
  BIT 1 $6
  BIT 1 $7
end

def BYTES1               # $0 = MOSI bit held for one byte, MISO ignored
  CLK $0
  CLK $0
  CLK $0
  CLK $0
  CLK $0
  CLK $0
  CLK $0
  CLK $0
end

def BYTES8
  BYTES1 $0
  BYTES1 $0
  BYTES1 $0
  BYTES1 $0
  BYTES1 $0
  BYTES1 $0
  BYTES1 $0
  BYTES1 $0
end

def BYTES64
  BYTES8 $0
  BYTES8 $0
  BYTES8 $0
  BYTES8 $0
  BYTES8 $0
  BYTES8 $0
  BYTES8 $0
  BYTES8 $0
end

def SKIP_509             # 509 bytes, MOSI = $0
  BYTES64 $0
  BYTES64 $0
  BYTES64 $0
  BYTES64 $0
  BYTES64 $0
  BYTES64 $0
  BYTES64 $0
  BYTES8 $0
  BYTES8 $0
  BYTES8 $0
  BYTES8 $0
  BYTES8 $0
  BYTES8 $0
  BYTES8 $0
  BYTES1 $0
  BYTES1 $0
  BYTES1 $0
  BYTES1 $0
  BYTES1 $0
end

def SKIP_510             # 510 bytes, MOSI = $0
  SKIP_509 $0
  BYTES1 $0
end

def SKIP_511             # 511 bytes, MOSI = $0
  SKIP_510 $0
  BYTES1 $0
end

def SELECT
  drive NotCS = L
  step
  step
end

def DESELECT
  drive NotCS = H
  step
  step
end

def CMD0                 # GO_IDLE_STATE
  TXB 0 1 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 1 0 0 1 0 1 0 1
end

def CMD8                 # SEND_IF_COND, 2.7-3.6 V, check pattern 0xAA
  TXB 0 1 0 0 1 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 1
  TXB 1 0 1 0 1 0 1 0
  TXB 1 0 0 0 0 1 1 1
end

def CMD55                 # APP_CMD
  TXB 0 1 1 1 0 1 1 1
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 1 1 0 0 1 0 1
end

def ACMD41                 # SD_SEND_OP_COND, HCS set
  TXB 0 1 1 0 1 0 0 1
  TXB 0 1 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 1 1 1 0 1 1 1
end

def CMD58                 # READ_OCR
  TXB 0 1 1 1 1 0 1 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 1 1 1 1 1 1 0 1
end

def CMD59_ON                 # CRC_ON_OFF = on
  TXB 0 1 1 1 1 0 1 1
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 1
  TXB 1 0 0 0 0 0 1 1
end

def CMD59_OFF                 # CRC_ON_OFF = off
  TXB 0 1 1 1 1 0 1 1
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 1 0 0 1 0 0 0 1
end

def CMD9                 # SEND_CSD
  TXB 0 1 0 0 1 0 0 1
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 1 0 1 0 1 1 1 1
end

def CMD10                 # SEND_CID
  TXB 0 1 0 0 1 0 1 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 1 1 0 1 1
end

def CMD12                 # STOP_TRANSMISSION
  TXB 0 1 0 0 1 1 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 1 1 0 0 0 0 1
end

def CMD13                 # SEND_STATUS
  TXB 0 1 0 0 1 1 0 1
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 1 1 0 1
end

def CMD1                 # SEND_OP_COND (MMC only)
  TXB 0 1 0 0 0 0 0 1
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 1 1 1 1 1 0 0 1
end

def CMD17_BLK                 # $0 $1 = block number bits 1 and 0 (CRC byte unchecked unless CRC mode)
  TXB 0 1 0 1 0 0 0 1
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 $0 $1
  TXB 1 1 1 1 1 1 1 1
end

def CMD18_BLK                 # $0 $1 = block number bits 1 and 0 (CRC byte unchecked unless CRC mode)
  TXB 0 1 0 1 0 0 1 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 $0 $1
  TXB 1 1 1 1 1 1 1 1
end

def CMD24_BLK                 # $0 $1 = block number bits 1 and 0 (CRC byte unchecked unless CRC mode)
  TXB 0 1 0 1 1 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 $0 $1
  TXB 1 1 1 1 1 1 1 1
end

def CMD25_BLK                 # $0 $1 = block number bits 1 and 0 (CRC byte unchecked unless CRC mode)
  TXB 0 1 0 1 1 0 0 1
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 0 0
  TXB 0 0 0 0 0 0 $0 $1
  TXB 1 1 1 1 1 1 1 1
end

def RX_FF
  RXB 1 1 1 1 1 1 1 1
end

def RX_00
  RXB 0 0 0 0 0 0 0 0
end

def RX_R1                # response gap (0xFF) then R1 = $0..$7
  RX_FF
  RXB $0 $1 $2 $3 $4 $5 $6 $7
end

device SdCard path=sdcard-test.img size=0x4000000 fresh=1

print TAG=sd-deselected-miso-is-high-z
drive NotCS = H
drive SCLK = L
drive MOSI = H
step 2
expect MISO = F
print TAG=sd-reports-capacity-and-no-state-yet
expect reg.Blocks = 131072
expect reg.Ready = 0
expect mem[0x0] = 0x00
poke 0x400 0xA5
poke 0x401 0x5A
poke 0x5FF 0x81
poke 0x200 0x11
poke 0x7FF 0xFF
expect mem[0x400] = 0xA5
print TAG=sd-clocks-while-deselected-are-ignored
BYTES1 1
BYTES1 1
BYTES1 1
BYTES1 1
BYTES1 1
BYTES1 1
BYTES1 1
BYTES1 1
BYTES1 1
BYTES1 1
expect MISO = F
print TAG=sd-selected-idle-miso-is-high
SELECT
expect MISO = H
print TAG=sd-cmd0-enters-idle
CMD0
RX_R1 0 0 0 0 0 0 0 1
expect reg.LastCmd = 0
expect reg.Ready = 0
expect reg.LastR1 = 0x01
print TAG=sd-cmd8-echoes-voltage-and-pattern
CMD8
