{
    "name": "WireSim",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },
    "remoteUser": "dev",
    // Bind mount sources must exist before the container starts.
    "initializeCommand": [
        "sh", "-c",
        "if [ -z \"$1\" ]; then echo 'HOME must be set on the host' >&2; exit 1; fi; mkdir -p \"$1/.copilot/instructions\" && if [ ! -e \"$1/.copilot/copilot-instructions.md\" ]; then touch \"$1/.copilot/copilot-instructions.md\"; fi",
        "sh", "${localEnv:HOME}"
    ],
    // Rootless Podman: map the invoking host user onto the image's uid/gid
    // 1000 so it owns the bind-mounted Wayland socket below. keep-groups
    // carries host supplementary groups (video/render) into the container
    // by gid, without needing matching group names in /etc/group. DRI
    // access enables real GPU accel for the SDL2 renderer instead of
    // falling back to llvmpipe. label=disable skips SELinux relabeling of
    // the live XDG_RUNTIME_DIR (relabeling it in place would affect every
    // other app using it on the host).
    "runArgs": [
        "--userns=keep-id:uid=1000,gid=1000",
        "--group-add=keep-groups",
        "--security-opt=label=disable",
        "--device=/dev/dri"
    ],
    // Bind the host's live Wayland socket and XWayland fallback socket
    // directory in at identical paths, so WAYLAND_DISPLAY/DISPLAY resolve
    // the same way inside the container as outside it.
    //
    "mounts": [
        "source=${localEnv:XDG_RUNTIME_DIR},target=${localEnv:XDG_RUNTIME_DIR},type=bind",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
        "source=${localEnv:HOME}/.copilot/copilot-instructions.md,target=/home/dev/.copilot/copilot-instructions.md,type=bind,readonly",
        "source=${localEnv:HOME}/.copilot/instructions,target=/home/dev/.copilot/instructions,type=bind,readonly"
    ],
    "containerEnv": {
        "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
        "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
        "DISPLAY": "${localEnv:DISPLAY}",
        // Try native Wayland first, fall back to XWayland/X11 -- covers
        // both this machine (Fedora KDE/Wayland) and other Linux hosts.
        "SDL_VIDEODRIVER": "wayland,x11"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "C_Cpp.intelliSenseEngine": "disabled",
                "clangd.path": "clangd",
                "clangd.arguments": [
                    "--background-index",
                    "--header-insertion=never"
                ],
                // Presets in CMakePresets.json; the status-bar Debug button
                // launches the selected target under gdb.
                "cmake.useCMakePresets": "always",
                "cmake.debugConfig": {
                    "type": "cppdbg",
                    "MIMode": "gdb",
                    "stopAtEntry": false
                },
                // Both assembler extensions claim .asm/.inc, so pick the language per
                // machine folder. Z80Echo is sjasmplus; the 6502 machines are ca65.
                "files.associations": {
                    "**/src/Machines/Z80Echo/**/*.{asm,inc}": "sjasmplus",
                    "**/src/Machines/{My6502,BenEater6502}/**/*.{asm,s,inc}": "ca65"
                },
                // Keep the sjasmplus symbol index (completion, go-to-definition,
                // diagnostics) out of the ca65 sources. ROM_BIN is passed as -D by
                // Firmware/build.sh.
                "sjasmplus-code-lens.excludeFiles": "**/src/Machines/{My6502,BenEater6502}/**",
                "sjasmplus-code-lens.defines": ["ROM_BIN"]
            },
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "tlgkccampbell.code-ca65",
                "mshr-h.veriloghdl",
                "kolnogorov.sjasmplus-code-lens"
            ]
        }
    }
}